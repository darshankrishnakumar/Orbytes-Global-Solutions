# ==========================================
# Orbytes Global Solutions - Environment Variables
# ==========================================

# Production Site URL
NEXT_PUBLIC_SITE_URL=https://orbytesglobal.com

# TiDB Cloud Serverless Connection String
# Get this from TiDB Cloud Console -> Cluster -> Connect -> Connection String
# Example: mysql://<username>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database_name>?ssl={"rejectUnauthorized":true}
TIDB_DATABASE_URL="mysql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?ssl={\"rejectUnauthorized\":true}"

# Optional Web3Forms Access Key for email notifications (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=
